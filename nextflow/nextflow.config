/*
 * Nextflow configuration for HPC cluster with SLURM
 * Optimized for GSE235063 single-cell analysis pipeline
 */

// SLURM executor configuration
process {
    executor = 'slurm'
    queue = 'free'
    
    // Optimized resource configuration: 8 CPUs/16GB for samples, 16 CPUs/128GB for integration
    withLabel: 'cellbender' {
        cpus = 8
        memory = '16GB'
        time = { params.debug ? '2h' : '8h' }
        queue = 'free'
    }
    
    withLabel: 'qc' {
        cpus = 8
        memory = '16GB'
        time = { params.debug ? '2h' : '4h' }
        queue = 'free'
    }
    
    withLabel: 'integration' {
        cpus = 16
        memory = '128GB'
        time = { params.debug ? '4h' : '8h' }
        queue = 'free'
    }
    
    withLabel: 'annotation' {
        cpus = 8
        memory = '16GB'
        time = { params.debug ? '2h' : '2h' }
        queue = 'free'
    }
    
    // Error handling
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors = '-1'
}

// Environment configuration
env {
    PYTHONPATH = "$PWD/src"
    RAY_DISABLE_IMPORT_WARNING = 1
}

// Singularity configuration (if using containers)
singularity {
    enabled = false
    autoMounts = true
}

// Resource limits for HPC
executor {
    queueSize = 100
    submitRateLimit = '10 sec'
}

// Report and timeline options
dag {
    enabled = true
    file = "reports/pipeline_dag.html"
}

report {
    enabled = true
    file = "reports/pipeline_report.html"
}

timeline {
    enabled = true
    file = "reports/timeline.html"
}

trace {
    enabled = true
    file = "reports/trace.txt"
    overwrite = true
}

// Scratch directory for temporary files
scratch = '/tmp'

// Cleanup temporary files
cleanup = true

// Resume capability
resume = true