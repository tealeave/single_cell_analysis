/*
 * Nextflow configuration for HPC cluster with SLURM
 * Optimized for GSE235063 single-cell analysis pipeline
 */

// SLURM executor configuration
process {
    executor = 'slurm'
    queue = 'free'
    
    // Resource scaling based on debug mode
    withLabel: 'cellbender' {
        cpus = { params.debug ? 2 : 8 }
        memory = { params.debug ? '8GB' : '32GB' }
        time = { params.debug ? '2h' : '8h' }
        queue = 'normal'
    }
    
    withLabel: 'qc' {
        cpus = { params.debug ? 2 : 4 }
        memory = { params.debug ? '4GB' : '16GB' }
        time = { params.debug ? '1h' : '4h' }
        queue = 'normal'
    }
    
    withLabel: 'integration' {
        cpus = { params.debug ? 4 : 8 }
        memory = { params.debug ? '8GB' : '16GB' }
        time = { params.debug ? '2h' : '4h' }
        queue = 'normal'
    }
    
    withLabel: 'annotation' {
        cpus = { params.debug ? 2 : 4 }
        memory = { params.debug ? '4GB' : '8GB' }
        time = { params.debug ? '1h' : '2h' }
        queue = 'normal'
    }
    
    // Error handling
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors = '-1'
}

// Environment configuration
env {
    PYTHONPATH = "$PWD/src"
    RAY_DISABLE_IMPORT_WARNING = 1
}

// Singularity configuration (if using containers)
singularity {
    enabled = false
    autoMounts = true
}

// Resource limits for HPC
executor {
    queueSize = 100
    submitRateLimit = '10 sec'
}

// Report and timeline options
dag {
    enabled = true
    file = "reports/pipeline_dag.html"
}

report {
    enabled = true
    file = "reports/pipeline_report.html"
}

timeline {
    enabled = true
    file = "reports/timeline.html"
}

trace {
    enabled = true
    file = "reports/trace.txt"
    overwrite = true
}

// Scratch directory for temporary files
scratch = '/tmp'

// Cleanup temporary files
cleanup = true

// Resume capability
resume = true